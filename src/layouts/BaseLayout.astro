---
import '../styles/global.css';
const { title = 'Personal Archive', description = 'An independent archive of creative and technical work.', projects = [] } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f0ea" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('archive-theme');
        document.documentElement.dataset.theme = saved || 'system';
      })();
    </script>
    {projects.length > 0 && (
      <script is:inline>
        window.ARCHIVE_PROJECTS = JSON.parse('{JSON.stringify(projects)}');
      </script>
    )}
  </head>
  <body>
    <slot />
    <div class="cursor" id="cursor"></div>
    <div class="search-modal" id="search-modal" hidden>
      <div class="search-modal-backdrop"></div>
      <div class="search-modal-panel">
        <span class="search-modal-kicker">SEARCH THE ARCHIVE</span>
        <input type="search" id="search-modal-input" placeholder="Search projects…" aria-label="Search projects" autofocus />
        <div id="search-modal-results"></div>
        <span class="search-modal-hint">⌘K to open · Esc to close</span>
      </div>
    </div>
    <script>
      (() => {
        const cursor = document.getElementById('cursor');
        if (!cursor) return;
        window.addEventListener('mousemove', (e) => {
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
        });
        const interactive = document.querySelectorAll('a, button, input, [data-theme-toggle], .project-card, .text-link, .contact-link, .filter-button, .enter-button');
        interactive.forEach((el) => {
          el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
          el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
        });
      })();
    </script>
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
    <script>
      const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const label = button?.querySelector('[data-theme-label]');
      const updateLabel = () => {
        const theme = document.documentElement.dataset.theme || 'system';
        if (label) label.textContent = theme === 'dark' ? 'Dark' : theme === 'light' ? 'Light' : 'System';
      };
      button?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme || 'system';
        const next = current === 'system' ? 'dark' : current === 'dark' ? 'light' : 'system';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('archive-theme', next);
        updateLabel();
      });
      updateLabel();
    </script>
    <script>
      (() => {
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-modal-input');
        const results = document.getElementById('search-modal-results');
        const projects = window.ARCHIVE_PROJECTS || [];
        if (!modal || !input || !results || projects.length === 0) return;
        const open = () => { modal.hidden = false; input.focus(); document.body.style.overflow = 'hidden'; };
        const close = () => { modal.hidden = true; input.value = ''; results.innerHTML = ''; document.body.style.overflow = ''; };
        window.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); open(); }
          if (e.key === 'Escape' && !modal.hidden) close();
        });
        input.addEventListener('input', () => {
          const q = input.value.toLowerCase().trim();
          results.innerHTML = '';
          if (!q) return;
          const matches = projects.filter((p) => `${p.title} ${p.description} ${p.medium} ${p.category}`.toLowerCase().includes(q)).slice(0, 8);
          matches.forEach((p) => {
            const item = document.createElement('a');
            item.href = `/projects/${p.slug}`;
            item.className = 'search-result-item';
            item.innerHTML = `<span class="search-result-title">${p.title}</span><span class="search-result-meta">${p.category} · ${p.year}</span>`;
            item.addEventListener('click', close);
            results.appendChild(item);
          });
          if (matches.length === 0) results.innerHTML = '<span class="search-result-empty">No matches</span>';
        });
        modal.querySelector('.search-modal-backdrop').addEventListener('click', close);
      })();
    </script>
  </body>
</html>
