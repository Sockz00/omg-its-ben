---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
const featured = projects.filter((project) => project.featured).slice(0, 3);
---
<BaseLayout title="Ben — Personal Archive" description="An independent archive of creative and technical work across art, sound, film and technology.">
  <div class="enter-overlay" id="enter-overlay">
    <div class="enter-inner">
      <h2 class="enter-heading">Enter the archive.</h2>
      <button class="enter-button" id="enter-button">ENTER</button>
    </div>
  </div>
  <script is:inline>
    (() => {
      const overlay = document.getElementById('enter-overlay');
      const button = document.getElementById('enter-button');
      if (!overlay || !button) return;
      button.addEventListener('click', () => {
        overlay.style.opacity = '0';
        setTimeout(() => { overlay.style.display = 'none'; }, 400);
      });
    })();
  </script>
  <div id="top"></div>
  <SiteHeader />
  <main>
    <section class="hero wrap">
      <div class="eyebrow"><span class="status-pip"></span> INDEPENDENT PRACTICE <span class="eyebrow-divider">/</span> EST. 2024—</div>
      <h1>A record of<br /><em>making things.</em></h1>
      <div class="hero-bottom">
        <p class="hero-intro">An evolving archive of work, experiments and ideas across creative practice and technology.</p>
        <div class="hero-meta"><span>ART · SOUND · IMAGE</span><span>CODE · SYSTEMS · RESEARCH</span></div>
      </div>
      <div class="hero-rule"><span>SELECTED INDEX</span><span>01 — 06</span></div>
    </section>

    <section class="featured-section wrap" aria-labelledby="featured-heading">
      <div class="section-heading"><div><span class="section-kicker">01 / SELECTED WORK</span><h2 id="featured-heading">Recent entries<span class="heading-period">.</span></h2></div><a class="text-link" href="/archive">VIEW ALL WORK <span>↗</span></a></div>
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="statement-section">
      <div class="wrap statement-inner"><span class="section-kicker">02 / APPROACH</span><p>Curiosity is the<br />common thread<span class="heading-period">.</span></p><div class="statement-aside">Different tools. Different disciplines.<br />One continuous practice of learning,<br />making and taking things apart.</div></div>
    </section>

    <section class="about-section wrap" id="about">
      <div class="section-heading"><div><span class="section-kicker">03 / ABOUT</span><h2>Many interests.<br /><em>One archive.</em></h2></div><p class="about-copy">I'm an independent multidisciplinary creative working across visual art, music, moving image and technology. This site documents finished work alongside experiments, processes and ongoing research.</p></div>
      <div class="discipline-list">
        <div><span>01</span><strong>Visual practice</strong><small>Photography / Digital art / Drawing / Design</small><b>↗</b></div>
        <div><span>02</span><strong>Sound & music</strong><small>Composition / Production / Recording / Sound design</small><b>↗</b></div>
        <div><span>03</span><strong>Moving image</strong><small>Videography / Cinematography / Editing</small><b>↗</b></div>
        <div><span>04</span><strong>Creative technology</strong><small>Programming / AI / Interactive experiments</small><b>↗</b></div>
        <div><span>05</span><strong>Technical research</strong><small>Cybersecurity / Systems / Independent research</small><b>↗</b></div>
      </div>
    </section>

    <section class="contact-section wrap" id="contact"><span class="section-kicker">04 / CONTACT</span><div class="contact-row"><h2>Have something<br /><em>in mind?</em></h2><a class="contact-link" href="mailto:hello@example.com">GET IN TOUCH <span>↗</span></a></div><p class="contact-note">For collaborations, commissions, questions or just to say hello.</p></section>
  </main>
  <SiteFooter />
</BaseLayout>
