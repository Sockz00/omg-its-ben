---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const related = projects.filter((item) => item.slug !== project.slug && item.category === project.category).slice(0, 2);
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : null;
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : null;
const wordCount = project.body.join(' ').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---
<BaseLayout title={`${project.title} — Ben`} description={project.description}>
  <div id="top"></div><SiteHeader />
  <main class="wrap detail-page">
    <a class="back-link" href="/archive">← BACK TO ARCHIVE</a>
    <div class="detail-heading"><div><span class="section-kicker">ENTRY / {project.index} · {project.category.toUpperCase()}</span><h1>{project.title}<span class="heading-period">.</span></h1><p>{project.description}</p></div><div class="detail-data"><span>YEAR <b>{project.year}</b></span><span>MEDIUM <b>{project.medium}</b></span><span>READING <b>{readingTime} min read</b></span></div></div>
    <div class={`detail-art project-art art-${project.accent}`}><span class="art-index">/{project.index}</span><span class="art-title">{project.title}</span><span class="art-symbol" aria-hidden="true">{project.category === 'Music' ? '∿' : project.category === 'Photography' ? '◉' : project.category === 'Film' ? '▱' : project.category === 'Creative technology' ? '⌘' : project.category === 'Research' ? '⌁' : '✳'}</span><span class="art-caption">{project.category.toUpperCase()} · {project.year}</span></div>
    <article class="detail-body"><span class="section-kicker">ABOUT THIS WORK</span><div>{project.body.map((paragraph) => <p>{paragraph}</p>)}</div></article>
    {project.links?.length ? <div class="detail-links">{project.links.map((link) => <a class="text-link" href={link.url} target="_blank" rel="noreferrer">{link.label.toUpperCase()} ↗</a>)}</div> : null}
<div class="detail-share"><button class="share-button" aria-label="Copy project link"><span>COPY LINK</span><span class="share-icon">⧉</span></button></div>
    {related.length ? <section class="related-section"><div class="section-heading"><div><span class="section-kicker">CONTINUE EXPLORING</span><h2>Related entries<span class="heading-period">.</span></h2></div><a class="text-link" href="/archive">ALL WORK ↗</a></div><div class="project-grid">{related.map((item) => <a class="project-card" href={`/projects/${item.slug}`}><div class={`project-art art-${item.accent}`}><span class="art-index">/{item.index}</span><span class="art-title">{item.title}</span><span class="art-symbol" aria-hidden="true">{item.category === 'Music' ? '∿' : item.category === 'Photography' ? '◉' : item.category === 'Film' ? '▱' : item.category === 'Creative technology' ? '⌘' : item.category === 'Research' ? '⌁' : '✳'}</span><span class="art-caption">{item.category.toUpperCase()} · {item.year}</span></div><div class="project-card-meta"><div><h3>{item.title}</h3><p>{item.description}</p></div><span class="arrow">↗</span></div></a>)}</div></section> : null}
<nav class="detail-nav">
  {prevProject && <a class="detail-nav-item detail-nav-prev" href={`/projects/${prevProject.slug}`}><span>PREVIOUS</span><span>{prevProject.title}</span><span>↑</span></a>}
  {nextProject && <a class="detail-nav-item detail-nav-next" href={`/projects/${nextProject.slug}`}><span>NEXT</span><span>{nextProject.title}</span><span>↓</span></a>}
</nav>
  </main>
  <script is:inline>
    (() => {
      const button = document.querySelector('.share-button');
      if (!button) return;
      const meta = document.querySelector('meta[name="description"]');
      button.addEventListener('click', async () => {
        const url = window.location.href;
        try {
          if (navigator.share) {
            await navigator.share({ title: document.title, text: meta?.content || '', url });
          } else {
            await navigator.clipboard.writeText(url);
            const original = button.innerHTML;
            button.innerHTML = '<span>COPIED</span><span class="share-icon">✓</span>';
            setTimeout(() => { button.innerHTML = original; }, 2000);
          }
        } catch (e) { /* share cancelled or blocked */ }
      });
    })();
  </script>
  <SiteFooter />
</BaseLayout>
