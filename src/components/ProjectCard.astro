---
import type { Project } from '../data/projects';
const { project } = Astro.props as { project: Project };
---
<a class="project-card" href={`/projects/${project.slug}`}>
  <div class={`project-art art-${project.accent}`}>
    <span class="art-index">/{project.index}</span>
    <span class="art-title">{project.title}</span>
    <span class="art-symbol" aria-hidden="true">{project.category === 'Music' ? '∿' : project.category === 'Photography' ? '◉' : project.category === 'Film' ? '▱' : project.category === 'Creative technology' ? '⌘' : project.category === 'Research' ? '⌁' : '✳'}</span>
    <span class="art-caption">{project.category.toUpperCase()} · {project.year}</span>
  </div>
  <div class="project-card-meta">
    <div><h3>{project.title}</h3><p>{project.description}</p></div>
    <span class="arrow" aria-hidden="true">↗</span>
  </div>
</a>
